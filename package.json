{
  "name": "qa-e2e-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Esteira de QA ponta a ponta: cria a massa pela API (Newman, data-driven), aguarda o processamento e valida/evidencia na interface (Playwright + TypeScript).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "e2e": "node pipeline/e2e.ts",
    "e2e:dry": "node pipeline/e2e.ts --dry",
    "massa": "node api/run.ts",
    "test:ui": "playwright test --project=ui",
    "test:unit": "playwright test --project=unit",
    "report": "playwright show-report reports/playwright",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/newman": "5.3.6",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-plugin-playwright": "2.12.0",
    "newman": "6.2.2",
    "newman-reporter-htmlextra": "1.23.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
